{
  "manifest_version": 3,
  "name": "Job Tracker Companion",
  "version": "1.0",
  "description": "Enregistrez en un clic vos offres d'emploi depuis HelloWork, Welcome to the Jungle, JobTeaser, Indeed, WeLoveDevs, La Bonne Alternance et LinkedIn dans votre dashboard.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.hellowork.com/*",
    "https://www.welcometothejungle.com/*",
    "https://*.jobteaser.com/*",
    "https://*.indeed.com/*",
    "https://*.welovedevs.com/*",
    "*://*.labonnealternance.apprentissage.beta.gouv.fr/*",
    "https://www.linkedin.com/jobs/*",
    "https://*.linkedin.com/jobs/*"
    
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hellowork.com/*",
        "https://www.welcometothejungle.com/*",
        "https://*.jobteaser.com/*",
        "https://*.indeed.com/*",
        "https://*.welovedevs.com/*",
        "*://*.labonnealternance.apprentissage.beta.gouv.fr/*",
        "https://www.linkedin.com/jobs/*",
        "https://*.linkedin.com/jobs/*"
        
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}