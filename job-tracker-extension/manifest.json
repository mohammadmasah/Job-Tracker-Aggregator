{
  "manifest_version": 3,
  "name": "Job Tracker Companion",
  "version": "1.0",
  "description": "Enregistrez facilement les offres d'emploi HelloWork, Welcome to the Jungle, JobTeaser et Indeed dans votre dashboard",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.hellowork.com/*",
    "https://www.welcometothejungle.com/*",
    "https://*.jobteaser.com/*",
    "https://*.indeed.com/*",
    "https://*.welovedevs.com/*",
    "*://*.labonnealternance.apprentissage.beta.gouv.fr/*"
    
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hellowork.com/*",
        "https://www.welcometothejungle.com/*",
        "https://*.jobteaser.com/*",
        "https://*.indeed.com/*",
        "https://*.welovedevs.com/*",
        "*://*.labonnealternance.apprentissage.beta.gouv.fr/*"
        
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}