{
  "manifest_version": 3,
  "name": "Job Tracker Companion",
  "version": "1.0",
  "description": "Enregistrez facilement les offres d'emploi HelloWork dans votre dashboard",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.hellowork.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hellowork.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}